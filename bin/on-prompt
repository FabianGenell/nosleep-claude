#!/bin/bash
HOOK=UserPromptSubmit
. "$(dirname "$0")/common.sh"

SESSION_ID=$(read_session_id)
[ -z "$SESSION_ID" ] && exit 0

CLAUDE_PID=$(find_claude_pid) || {
    log "session=$SESSION_ID could not find claude in ancestry from PPID=$PPID"
    exit 0
}

CPID_FILE="$NOSLEEP_DIR/$SESSION_ID.cpid"
LID_FILE="$NOSLEEP_DIR/$SESSION_ID.lid"

# Clean up any leftover caffeinate from an interrupted prompt in this session
if [ -f "$CPID_FILE" ]; then
    kill_pid_silent "$(cat "$CPID_FILE" 2>/dev/null)"
fi

# Spawn caffeinate tied to claude's PID. The -w means caffeinate will die
# automatically if claude crashes / the terminal is killed.
caffeinate -imsu -w "$CLAUDE_PID" </dev/null >/dev/null 2>&1 &
echo $! > "$CPID_FILE"
log "session=$SESSION_ID claude=$CLAUDE_PID caffeinate=$! (started)"

# Try lid-close suppression; silently no-ops if sudoers rule isn't installed
if disable_lid_sleep; then
    touch "$LID_FILE"
    log "session=$SESSION_ID lid-close sleep disabled"
fi

exit 0
