#!/bin/bash
HOOK=UserPromptSubmit
. "$(dirname "$0")/common.sh"

read_hook_input
SESSION_ID=$(hook_field session_id)
[ -z "$SESSION_ID" ] && exit 0

CWD=$(hook_field cwd)
PROJECT=$(basename "${CWD:-$PWD}")
LABEL=$(hook_field prompt | one_line)

# System-injected turns (task notifications, reminders) clean down to nothing
# useful, so keep whatever this session was last actually asked to do.
if [ "${#LABEL}" -lt 4 ] && [ -f "$NOSLEEP_DIR/$SESSION_ID.meta" ]; then
    LABEL=$(cut -f2 "$NOSLEEP_DIR/$SESSION_ID.meta" 2>/dev/null)
fi

# Drop any orphan state before we evaluate refcounts.
clean_stale_sessions

# Start a fresh grace timer; tool-call activity keeps extending it while
# Claude works.
refresh_caffeinate force

# Acquire shared lid-lock (refcounted across all sessions).
lid_lock_acquire

write_session_meta
record_event prompt

exit 0
