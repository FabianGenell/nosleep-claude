#!/bin/bash
# nosleep-claude: user-facing CLI for the nosleep-claude plugin.
# Status/health checks, plus installing or removing the optional sudoers
# rule that enables lid-closed sleep prevention on battery.
set -u

VERSION="1.5.0"
PLUGIN_ID="nosleep-claude@nosleep-claude"
MARKETPLACE="nosleep-claude"
NOSLEEP_DIR="/tmp/nosleep-claude"
SUDOERS_FILE="/etc/sudoers.d/nosleep-claude"
LOG_FILE="$NOSLEEP_DIR/nosleep-claude.log"
CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
SETTINGS_FILE="$CLAUDE_DIR/settings.json"
KNOWN_MARKETPLACES="$CLAUDE_DIR/plugins/known_marketplaces.json"
INSTALLED_PLUGINS="$CLAUDE_DIR/plugins/installed_plugins.json"
GRACE_SECS="${NOSLEEP_GRACE_SECS:-900}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/nosleep-claude"
EVENTS_FILE="$STATE_DIR/events.tsv"
MENUBAR_LABEL="net.genell.nosleepbar"
MENUBAR_PLIST="$HOME/Library/LaunchAgents/$MENUBAR_LABEL.plist"
MENUBAR_BIN="$HOME/.local/bin/nosleepbar"
MENUBAR_SRC="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd)/menubar/NoSleepBar.swift"

OK="✔"; BAD="✘"; MEH="–"

usage() {
    cat <<EOF
nosleep-claude $VERSION

Usage:
  nosleep-claude status              Full health check (wiring, hooks, awake state)
  nosleep-claude status --short      One line: OK / IDLE / STALE / BROKEN
  nosleep-claude status --json       Machine-readable snapshot
  nosleep-claude logs                Show recent hook log entries
  nosleep-claude stats [--json]      How long Claude has kept this Mac awake
  nosleep-claude menubar install     Build and start the menu bar indicator
  nosleep-claude menubar uninstall   Stop and remove it
  nosleep-claude menubar restart     Rebuild from source and reload
  nosleep-claude enable-lid-closed   Install sudoers rule for lid-closed support
                                     (prompts for sudo password once)
  nosleep-claude disable-lid-closed  Remove the sudoers rule
  nosleep-claude help                Show this help
  nosleep-claude --version           Print version

The plugin's hooks fire automatically on every Claude Code prompt and tool
call; there is no service to start or stop. Sleep prevention self-expires
15 minutes after Claude's last activity (override with NOSLEEP_GRACE_SECS).
Lid-closed sleep prevention on battery is the only opt-in piece (it needs
root to flip pmset).

status exits 0 when healthy or idle, 1 when the plugin is not actually wired
up (the failure mode where hooks silently never fire).
EOF
}

# ---------------------------------------------------------------- helpers

have_json() { command -v jq >/dev/null 2>&1 || command -v python3 >/dev/null 2>&1; }

# json_query <file> <jq-expression>: prints the result, empty on any failure.
json_query() {
    local file="$1" expr="$2"
    [ -f "$file" ] || return 0
    if command -v jq >/dev/null 2>&1; then
        jq -c -r "$expr // empty" "$file" 2>/dev/null
    elif command -v python3 >/dev/null 2>&1; then
        python3 - "$file" "$expr" <<'PY' 2>/dev/null
import json, sys
path, expr = sys.argv[1], sys.argv[2]
try:
    data = json.load(open(path))
except Exception:
    sys.exit(0)
# Only the handful of simple paths this CLI uses are supported.
cur = data
for part in expr.strip('.').split('|'):
    part = part.strip()
    if not part:
        continue
    if part.startswith('.'):
        part = part[1:]
    for key in part.replace('[', '.').replace(']', '').replace('"', '').split('.'):
        key = key.strip()
        if key == '':
            continue
        if isinstance(cur, list):
            try:
                cur = cur[int(key)]
            except Exception:
                sys.exit(0)
        elif isinstance(cur, dict):
            if key not in cur:
                sys.exit(0)
            cur = cur[key]
        else:
            sys.exit(0)
if cur is None:
    sys.exit(0)
print(cur if isinstance(cur, str) else json.dumps(cur, separators=(',', ':'), sort_keys=True))
PY
    fi
}

# jq prints objects with its own key order; normalise so two equal sources compare equal.
json_source() {
    local file="$1" expr="$2"
    if command -v jq >/dev/null 2>&1; then
        jq -c -S "$expr // empty" "$file" 2>/dev/null
    else
        json_query "$file" "$expr"
    fi
}

human_ago() {
    local secs="$1"
    if   [ "$secs" -lt 60 ]    ; then printf '%ss ago' "$secs"
    elif [ "$secs" -lt 3600 ]  ; then printf '%sm ago' "$((secs / 60))"
    elif [ "$secs" -lt 86400 ] ; then printf '%sh %sm ago' "$((secs / 3600))" "$(((secs % 3600) / 60))"
    else printf '%sd ago' "$((secs / 86400))"
    fi
}

# Seconds a caffeinate pid has been running (empty if gone).
pid_elapsed_secs() {
    local pid="$1" etime
    etime=$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')
    [ -n "$etime" ] || return 1
    printf '%s' "$etime" | awk -F'[-:]' '{
        if (NF == 4)      print $1*86400 + $2*3600 + $3*60 + $4
        else if (NF == 3) print $1*3600 + $2*60 + $3
        else              print $1*60 + $2
    }'
}

# Processes actually blocking idle system sleep, one "pid name" per line.
# powerd's "prevent sleep while display is on" is filtered out: it holds an
# assertion the whole time the screen is lit, which says nothing about
# whether the Mac will sleep once you walk away.
sleep_holders() {
    pmset -g assertions 2>/dev/null \
        | awk '/Listed by owning process/{seen=1; next} seen' \
        | grep 'PreventUserIdleSystemSleep' \
        | grep -v 'Prevent sleep while display is on' \
        | sed -E 's/^[[:space:]]*pid ([0-9]+)\(([^)]+)\).*/\1 \2/'
}

json_escape() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }

disablesleep_value() {
    local v
    v=$(pmset -g custom 2>/dev/null | grep -i 'disablesleep' | head -1 | awk '{print $NF}')
    printf '%s' "${v:-0}"
}

# --------------------------------------------------------------- status

cmd_status() {
    local short=0
    [ "${1:-}" = "--short" ] && short=1

    # --- wiring -----------------------------------------------------------
    local enabled marketplace_settings marketplace_known install_path
    local installed_version source_dir source_version=""
    local wiring_problem="" stale_install=""
    if have_json; then
        enabled=$(json_query "$SETTINGS_FILE" ".enabledPlugins.\"$PLUGIN_ID\"")
        marketplace_settings=$(json_source "$SETTINGS_FILE" ".extraKnownMarketplaces.\"$MARKETPLACE\".source")
        marketplace_known=$(json_source "$KNOWN_MARKETPLACES" ".\"$MARKETPLACE\".source")
        install_path=$(json_query "$INSTALLED_PLUGINS" ".plugins.\"$PLUGIN_ID\"[0].installPath")
        installed_version=$(json_query "$INSTALLED_PLUGINS" ".plugins.\"$PLUGIN_ID\"[0].version")
        source_dir=$(json_query "$KNOWN_MARKETPLACES" ".\"$MARKETPLACE\".source.path")
        if [ -n "$source_dir" ] && [ -f "$source_dir/.claude-plugin/plugin.json" ]; then
            source_version=$(json_query "$source_dir/.claude-plugin/plugin.json" ".version")
            if [ -n "$source_version" ] && [ -n "$installed_version" ] && \
               [ "$source_version" != "$installed_version" ]; then
                stale_install="installed v$installed_version, source dir has v$source_version. Run: claude plugin update $MARKETPLACE"
            fi
        fi

        if [ "$enabled" != "true" ]; then
            wiring_problem="plugin is not enabled in $SETTINGS_FILE (run: claude plugin install $PLUGIN_ID)"
        elif [ -z "$marketplace_known" ]; then
            wiring_problem="marketplace '$MARKETPLACE' is not registered (run: claude plugin marketplace add <path-or-repo>)"
        elif [ -n "$marketplace_settings" ] && [ "$marketplace_settings" != "$marketplace_known" ]; then
            wiring_problem="marketplace declaration in settings.json differs from the registry, so Claude Code refuses to load the plugin. Re-add it with: claude plugin marketplace remove $MARKETPLACE && claude plugin marketplace add <path-or-repo>"
        elif [ -n "$install_path" ] && [ ! -d "$install_path" ]; then
            wiring_problem="recorded install path is missing: $install_path"
        fi
    fi

    # --- hook activity ----------------------------------------------------
    local log_mtime="" log_age="" last_line=""
    if [ -f "$LOG_FILE" ]; then
        log_mtime=$(stat -f %m "$LOG_FILE" 2>/dev/null)
        [ -n "$log_mtime" ] && log_age=$(( $(date +%s) - log_mtime ))
        last_line=$(tail -1 "$LOG_FILE" 2>/dev/null)
    fi

    # --- live sessions ----------------------------------------------------
    local live_sessions=0 stale_sessions=0 f sid pid
    local -a session_lines=()
    if [ -d "$NOSLEEP_DIR" ]; then
        for f in "$NOSLEEP_DIR"/*.cpid; do
            [ -e "$f" ] || continue
            sid=$(basename "$f" .cpid)
            pid=$(cat "$f" 2>/dev/null)
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                live_sessions=$((live_sessions + 1))
                local elapsed left
                elapsed=$(pid_elapsed_secs "$pid" || echo 0)
                left=$((GRACE_SECS - elapsed))
                [ "$left" -lt 0 ] && left=0
                session_lines+=("  $OK $sid  caffeinate=$pid  ~$((left / 60))m ${left}s left")
            else
                stale_sessions=$((stale_sessions + 1))
                session_lines+=("  $MEH $sid  caffeinate=${pid:-?}  (dead, next hook cleans it up)")
            fi
        done
    fi

    # --- verdict ----------------------------------------------------------
    local verdict rc=0
    if [ -n "$wiring_problem" ]; then
        verdict="BROKEN: $wiring_problem"; rc=1
    elif [ ! -f "$LOG_FILE" ]; then
        verdict="BROKEN: hooks have never fired since boot. The plugin is wired up, so restart Claude Code to load it."; rc=1
    elif [ -n "$stale_install" ]; then
        verdict="STALE: $stale_install"
    elif [ "$live_sessions" -gt 0 ]; then
        verdict="OK: $live_sessions session(s) holding the Mac awake, last hook $(human_ago "$log_age")"
    else
        verdict="IDLE: no sleep block right now, last hook $(human_ago "$log_age")"
    fi

    if [ "$short" = "1" ]; then
        echo "$verdict"
        return $rc
    fi

    echo "nosleep-claude $VERSION"
    echo
    echo "$verdict"
    echo
    echo "Wiring"
    if ! have_json; then
        echo "  $MEH needs jq or python3 to read Claude Code's config"
    else
        row() { printf '  %s %-20s %s\n' "$1" "$2" "$3"; }
        if [ "$enabled" = "true" ]; then row "$OK" "plugin enabled" "$PLUGIN_ID"
        else                             row "$BAD" "plugin enabled" "not enabled in settings.json"; fi
        if [ -n "$marketplace_known" ]; then row "$OK" "marketplace" "$marketplace_known"
        else                                 row "$BAD" "marketplace" "not registered"; fi
        if [ -z "$marketplace_settings" ] || [ "$marketplace_settings" = "$marketplace_known" ]; then
            row "$OK" "settings vs registry" "declarations agree"
        else
            row "$BAD" "settings vs registry" "MISMATCH"
            echo "       settings: $marketplace_settings"
            echo "       registry: $marketplace_known"
        fi
        if [ -n "$install_path" ] && [ -d "$install_path" ]; then row "$OK" "installed at" "$install_path"
        elif [ -n "$install_path" ];                          then row "$BAD" "installed at" "MISSING: $install_path"
        else                                                       row "$BAD" "installed at" "no install recorded"; fi
        if [ -n "$stale_install" ]; then row "$BAD" "version" "$stale_install"
        elif [ -n "$installed_version" ]; then row "$OK" "version" "v$installed_version"; fi
    fi
    echo

    echo "Hook activity"
    if [ -f "$LOG_FILE" ]; then
        printf '  %s %-20s %s\n' "$OK" "last hook" "$(date -r "$log_mtime" '+%Y-%m-%d %H:%M:%S') ($(human_ago "$log_age"))"
        [ -n "$last_line" ] && printf '  %s %-20s %s\n' " " "" "$last_line"
        printf '  %s %-20s %s\n' " " "log" "$LOG_FILE"
    else
        echo "  $BAD no hooks have fired since boot (no $LOG_FILE)"
    fi
    echo

    echo "Awake state"
    printf '  %s %-20s %s\n' " " "grace window" "$GRACE_SECS s ($((GRACE_SECS / 60)) min after last activity)"
    if [ "${#session_lines[@]}" -gt 0 ]; then
        printf '%s\n' "${session_lines[@]}"
    else
        echo "  $MEH no sessions holding a timer"
    fi
    local caff
    caff=$(pgrep -f 'caffeinate -imsu' 2>/dev/null | wc -l | tr -d ' ')
    printf '  %s %-20s %s\n' " " "caffeinate" "$caff process(es) from this plugin"
    if [ -f "$SUDOERS_FILE" ]; then
        printf '  %s %-20s %s\n' "$OK" "lid-closed" "enabled (sudoers rule present), pmset disablesleep = $(disablesleep_value)"
    else
        printf '  %s %-20s %s\n' "$MEH" "lid-closed" "off, run: nosleep-claude enable-lid-closed"
    fi
    echo

    echo "Claude processes"
    if pgrep -x claude >/dev/null 2>&1; then
        pgrep -x claude | while read -r p; do
            ps -o pid,args -p "$p" 2>/dev/null | tail -1 | cut -c1-110 | awk '{print "     " $0}'
        done
    else
        echo "  $MEH none running"
    fi

    return $rc
}

# ---------------------------------------------------------------- json

# Machine-readable snapshot, used by the menu bar app and anything else that
# wants to know whether this Mac is going to sleep.
cmd_status_json() {
    local live=0 left=0 elapsed pid f sid detail=""
    local -a session_pids=()
    if [ -d "$NOSLEEP_DIR" ]; then
        for f in "$NOSLEEP_DIR"/*.cpid; do
            [ -e "$f" ] || continue
            pid=$(cat "$f" 2>/dev/null)
            if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
                live=$((live + 1))
                session_pids+=("$pid")
                sid=$(basename "$f" .cpid)
                elapsed=$(pid_elapsed_secs "$pid" || echo 0)
                local this_left=$((GRACE_SECS - elapsed))
                [ "$this_left" -lt 0 ] && this_left=0
                [ "$this_left" -gt "$left" ] && left=$this_left

                # Who this session is: written by the prompt hook, so a session
                # that has not been prompted yet simply has no name to show.
                local meta_project="" meta_label="" meta_at=0
                if [ -f "$NOSLEEP_DIR/$sid.meta" ]; then
                    IFS=$'\t' read -r meta_project meta_label meta_at < "$NOSLEEP_DIR/$sid.meta"
                fi
                detail="${detail:+$detail,}{\"session\":\"$(json_escape "${sid:0:8}")\",\"project\":\"$(json_escape "$meta_project")\",\"label\":\"$(json_escape "$meta_label")\",\"seconds_left\":$this_left,\"last_prompt\":${meta_at:-0}}"
            fi
        done
    fi

    # Who is holding idle sleep open, with our own caffeinates named.
    local holders="" name hpid seen
    while read -r hpid name; do
        [ -n "$hpid" ] || continue
        for pid in ${session_pids[@]+"${session_pids[@]}"}; do
            [ "$hpid" = "$pid" ] && name="nosleep-claude"
        done
        # A bare caffeinate says nothing useful; name it after whatever spawned it
        # (Claude Code runs its own short caffeinate while a turn is in flight).
        if [ "$name" = "caffeinate" ]; then
            local parent
            parent=$(ps -o comm= -p "$(ps -o ppid= -p "$hpid" 2>/dev/null | tr -d ' ')" 2>/dev/null)
            parent=$(basename "${parent:-caffeinate}")
            [ -n "$parent" ] && [ "$parent" != "caffeinate" ] && name="$parent"
        fi
        case ",$holders," in *",$name,"*) continue ;; esac
        holders="${holders:+$holders,}$name"
    done < <(sleep_holders)

    local blocked=false
    [ -n "$holders" ] && blocked=true

    local last_epoch=0 last_age=-1 last_line=""
    if [ -f "$LOG_FILE" ]; then
        last_epoch=$(stat -f %m "$LOG_FILE" 2>/dev/null || echo 0)
        [ "$last_epoch" -gt 0 ] && last_age=$(( $(date +%s) - last_epoch ))
        last_line=$(tail -1 "$LOG_FILE" 2>/dev/null)
    fi

    local lid_rule=false
    [ -f "$SUDOERS_FILE" ] && lid_rule=true
    local disablesleep; disablesleep=$(disablesleep_value)
    local lid_blocked=false
    [ "$disablesleep" = "1" ] && lid_blocked=true

    local verdict healthy=true
    if [ ! -f "$LOG_FILE" ]; then
        verdict="BROKEN"; healthy=false
    elif [ "$live" -gt 0 ]; then
        verdict="OK"
    else
        verdict="IDLE"
    fi

    # Holder list as a JSON array.
    local arr="" h
    local IFS=,
    for h in $holders; do
        arr="${arr:+$arr,}\"$(json_escape "$h")\""
    done
    unset IFS

    printf '{'
    printf '"version":"%s",' "$VERSION"
    printf '"verdict":"%s",' "$verdict"
    printf '"healthy":%s,' "$healthy"
    printf '"sleep_blocked":%s,' "$blocked"
    printf '"blocked_by":[%s],' "$arr"
    printf '"sessions":%s,' "$live"
    printf '"sessions_detail":[%s],' "$detail"
    printf '"seconds_left":%s,' "$left"
    printf '"grace_secs":%s,' "$GRACE_SECS"
    printf '"lid_rule_installed":%s,' "$lid_rule"
    printf '"lid_closed_blocked":%s,' "$lid_blocked"
    printf '"last_hook_epoch":%s,' "$last_epoch"
    printf '"last_hook_age":%s,' "$last_age"
    printf '"last_hook_line":"%s",' "$(json_escape "$last_line")"

    # Totals for the menu bar readout. Cheap enough to recompute each poll:
    # the history is one line per prompt or stop.
    local today_held=0 today_worked=0 today_prompts=0 week_held=0 all_held=0
    if [ -f "$EVENTS_FILE" ]; then
        local statline
        while IFS= read -r statline; do
            case "$statline" in STAT_*) eval "$statline" ;; esac
        done < <(stats_compute env 2>/dev/null)
        today_held=${STAT_TODAY_HELD:-0}
        today_worked=${STAT_TODAY_WORKED:-0}
        today_prompts=${STAT_TODAY_PROMPTS:-0}
        week_held=${STAT_7D_HELD:-0}
        all_held=${STAT_ALL_HELD:-0}
    fi
    printf '"stats":{"today_held":%s,"today_worked":%s,"today_prompts":%s,"week_held":%s,"all_held":%s}' \
        "$today_held" "$today_worked" "$today_prompts" "$week_held" "$all_held"
    printf '}\n'
}

# ------------------------------------------------------------- menu bar

menubar_running() { launchctl list 2>/dev/null | grep -q "$MENUBAR_LABEL"; }

menubar_build() {
    if [ ! -f "$MENUBAR_SRC" ]; then
        echo "error: menu bar source not found at $MENUBAR_SRC" >&2
        return 1
    fi
    if ! command -v swiftc >/dev/null 2>&1; then
        echo "error: swiftc not found. Install the Xcode command line tools:" >&2
        echo "  xcode-select --install" >&2
        return 1
    fi
    mkdir -p "$(dirname "$MENUBAR_BIN")"
    echo "building $MENUBAR_BIN"
    swiftc -O -o "$MENUBAR_BIN" "$MENUBAR_SRC" || return 1
}

# Symbol overrides are optional: set NOSLEEP_SYMBOL_AWAKE / _SLEEP when running
# install or restart to try a different glyph pair without touching the source.
symbol_overrides() {
    [ -n "${NOSLEEP_SYMBOL_AWAKE:-}" ] && printf '\n\t\t<key>NOSLEEP_SYMBOL_AWAKE</key>\n\t\t<string>%s</string>' "$NOSLEEP_SYMBOL_AWAKE"
    [ -n "${NOSLEEP_SYMBOL_SLEEP:-}" ] && printf '\n\t\t<key>NOSLEEP_SYMBOL_SLEEP</key>\n\t\t<string>%s</string>' "$NOSLEEP_SYMBOL_SLEEP"
    [ -n "${NOSLEEP_GLYPH_SIZE:-}" ] && printf '\n\t\t<key>NOSLEEP_GLYPH_SIZE</key>\n\t\t<string>%s</string>' "$NOSLEEP_GLYPH_SIZE"
    return 0
}

menubar_write_plist() {
    mkdir -p "$(dirname "$MENUBAR_PLIST")"
    cat > "$MENUBAR_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$MENUBAR_LABEL</string>
	<key>ProgramArguments</key>
	<array>
		<string>$MENUBAR_BIN</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>NOSLEEP_CLI</key>
		<string>$(cd "$(dirname "$0")" && pwd)/nosleep-claude</string>$(symbol_overrides)
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>StandardErrorPath</key>
	<string>/tmp/nosleepbar.err.log</string>
</dict>
</plist>
PLIST
}

menubar_load() {
    launchctl bootout "gui/$(id -u)/$MENUBAR_LABEL" >/dev/null 2>&1 || true
    launchctl bootstrap "gui/$(id -u)" "$MENUBAR_PLIST" 2>/dev/null \
        || launchctl load "$MENUBAR_PLIST" 2>/dev/null
}

cmd_menubar() {
    case "${1:-status}" in
        install)
            menubar_build || exit 1
            menubar_write_plist
            menubar_load
            sleep 1
            if menubar_running; then
                echo "menu bar indicator running (look for the cup icon in the top bar)"
            else
                echo "launched, but launchctl does not list it. See /tmp/nosleepbar.err.log" >&2
                exit 1
            fi
            ;;
        uninstall)
            launchctl bootout "gui/$(id -u)/$MENUBAR_LABEL" >/dev/null 2>&1 \
                || launchctl unload "$MENUBAR_PLIST" >/dev/null 2>&1 || true
            rm -f "$MENUBAR_PLIST"
            pkill -f "$MENUBAR_BIN" 2>/dev/null || true
            echo "menu bar indicator removed (binary left at $MENUBAR_BIN)"
            ;;
        restart)
            menubar_build || exit 1
            menubar_write_plist
            menubar_load
            echo "menu bar indicator reloaded"
            ;;
        status)
            if menubar_running; then
                echo "menu bar indicator: running ($MENUBAR_BIN)"
            elif [ -f "$MENUBAR_PLIST" ]; then
                echo "menu bar indicator: installed but not running. See /tmp/nosleepbar.err.log"
            else
                echo "menu bar indicator: not installed. Run: nosleep-claude menubar install"
            fi
            ;;
        *)
            echo "unknown menubar command: $1" >&2
            echo "usage: nosleep-claude menubar [install|uninstall|restart|status]" >&2
            exit 2
            ;;
    esac
}

# ----------------------------------------------------------------- stats

# The event history is a flat TSV of prompt/stop/end rows. Turning that into
# "how long was this Mac awake because of Claude" needs interval merging, so
# the arithmetic lives in python rather than being faked in awk.
#
#   held   union of [prompt, last activity + grace] across every session,
#          which is wall-clock time the Mac stayed up because of this plugin
#   worked sum of prompt -> stop per session, so two sessions working at once
#          count twice, because they did
stats_compute() {
    local mode="${1:-json}"
    if ! command -v python3 >/dev/null 2>&1; then
        [ "$mode" = "json" ] && echo '{"error":"python3 not available"}'
        return 1
    fi
    python3 - "$EVENTS_FILE" "$GRACE_SECS" "$mode" <<'PY'
import json, sys, time
from datetime import datetime

path, grace, mode = sys.argv[1], int(sys.argv[2]), sys.argv[3]
now = int(time.time())

rows = []
try:
    with open(path) as handle:
        for line in handle:
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 3:
                continue
            try:
                epoch = int(parts[0])
            except ValueError:
                continue
            rows.append({
                "epoch": epoch,
                "event": parts[1],
                "session": parts[2],
                "project": parts[3] if len(parts) > 3 else "",
                "label": parts[4] if len(parts) > 4 else "",
            })
except FileNotFoundError:
    rows = []

rows.sort(key=lambda r: r["epoch"])

by_session = {}
for row in rows:
    by_session.setdefault(row["session"], []).append(row)

work = []   # (start, end, project)
hold = []   # (start, end)
for session, events in by_session.items():
    for i, row in enumerate(events):
        if row["event"] != "prompt":
            continue
        end = None
        for later in events[i + 1:]:
            if later["event"] in ("stop", "end", "prompt"):
                end = later["epoch"]
                break
        # No closing event means the turn is still open, or the session died
        # mid-flight. Either way the timer could only have run a grace window.
        capped = min(now, row["epoch"] + grace)
        end = min(end, now) if end is not None else capped
        if end < row["epoch"]:
            end = row["epoch"]
        work.append((row["epoch"], end, row["project"] or "unknown"))
        hold.append((row["epoch"], min(now, end + grace)))

def merge(intervals):
    merged = []
    for start, end in sorted(intervals):
        if merged and start <= merged[-1][1]:
            merged[-1][1] = max(merged[-1][1], end)
        else:
            merged.append([start, end])
    return merged

merged_hold = merge(hold)

def clipped(intervals, since):
    total = 0
    for start, end in intervals:
        lo, hi = max(start, since), min(end, now)
        if hi > lo:
            total += hi - lo
    return total

midnight = int(datetime.fromtimestamp(now).replace(hour=0, minute=0, second=0, microsecond=0).timestamp())
first = rows[0]["epoch"] if rows else now
windows = {
    "today": midnight,
    "7d": now - 7 * 86400,
    "30d": now - 30 * 86400,
    "all": first,
}

def window_stats(since):
    prompts = [r for r in rows if r["event"] == "prompt" and r["epoch"] >= since]
    return {
        "held": clipped(merged_hold, since),
        "worked": clipped([(a, b) for a, b, _ in work], since),
        "prompts": len(prompts),
        "sessions": len({r["session"] for r in prompts}),
        "since": since,
    }

result = {name: window_stats(since) for name, since in windows.items()}

projects = {}
for start, end, project in work:
    if end < windows["30d"]:
        continue
    bucket = projects.setdefault(project, {"project": project, "worked": 0, "prompts": 0})
    bucket["worked"] += max(0, min(end, now) - max(start, windows["30d"]))
for row in rows:
    if row["event"] == "prompt" and row["epoch"] >= windows["30d"]:
        bucket = projects.setdefault(row["project"] or "unknown", {"project": row["project"] or "unknown", "worked": 0, "prompts": 0})
        bucket["prompts"] += 1

longest = max(merged_hold, key=lambda pair: pair[1] - pair[0], default=None)

payload = {
    "windows": result,
    "projects": sorted(projects.values(), key=lambda p: -p["worked"])[:8],
    "longest": ({"secs": longest[1] - longest[0], "epoch": longest[0]} if longest else None),
    "sessions_seen": len(by_session),
    "first_event": first if rows else 0,
    "events": len(rows),
    "grace": grace,
}

if mode == "json":
    print(json.dumps(payload))
else:
    for name in ("today", "7d", "30d", "all"):
        key = name.upper().replace("D", "D")
        stats = result[name]
        print(f'STAT_{name.upper()}_HELD={stats["held"]}')
        print(f'STAT_{name.upper()}_WORKED={stats["worked"]}')
        print(f'STAT_{name.upper()}_PROMPTS={stats["prompts"]}')
        print(f'STAT_{name.upper()}_SESSIONS={stats["sessions"]}')
    print(f'STAT_EVENTS={payload["events"]}')
PY
}

human_dur() {
    local secs="${1:-0}"
    if   [ "$secs" -lt 60 ]   ; then printf '%ss' "$secs"
    elif [ "$secs" -lt 3600 ] ; then printf '%sm' "$((secs / 60))"
    else printf '%sh %02dm' "$((secs / 3600))" "$(((secs % 3600) / 60))"
    fi
}

cmd_stats() {
    if [ "${1:-}" = "--json" ]; then
        stats_compute json
        return
    fi
    if [ ! -f "$EVENTS_FILE" ]; then
        echo "No history yet at $EVENTS_FILE."
        echo "It starts filling on the next prompt in a session that has the plugin loaded."
        return 0
    fi
    local line
    while IFS= read -r line; do
        case "$line" in STAT_*) eval "$line" ;; esac
    done < <(stats_compute env)

    echo "nosleep-claude $VERSION"
    echo
    printf '%-10s %10s   %10s   %8s   %s\n' "" "AWAKE" "WORKING" "PROMPTS" "SESSIONS"
    printf '%-10s %10s   %10s   %8s   %s\n' "today" "$(human_dur "${STAT_TODAY_HELD:-0}")" "$(human_dur "${STAT_TODAY_WORKED:-0}")" "${STAT_TODAY_PROMPTS:-0}" "${STAT_TODAY_SESSIONS:-0}"
    printf '%-10s %10s   %10s   %8s   %s\n' "7 days" "$(human_dur "${STAT_7D_HELD:-0}")" "$(human_dur "${STAT_7D_WORKED:-0}")" "${STAT_7D_PROMPTS:-0}" "${STAT_7D_SESSIONS:-0}"
    printf '%-10s %10s   %10s   %8s   %s\n' "30 days" "$(human_dur "${STAT_30D_HELD:-0}")" "$(human_dur "${STAT_30D_WORKED:-0}")" "${STAT_30D_PROMPTS:-0}" "${STAT_30D_SESSIONS:-0}"
    printf '%-10s %10s   %10s   %8s   %s\n' "all time" "$(human_dur "${STAT_ALL_HELD:-0}")" "$(human_dur "${STAT_ALL_WORKED:-0}")" "${STAT_ALL_PROMPTS:-0}" "${STAT_ALL_SESSIONS:-0}"
    echo
    echo "awake   = wall clock the Mac stayed up because of this plugin (work plus grace)"
    echo "working = time Claude spent answering, summed per session"
    echo

    if command -v jq >/dev/null 2>&1; then
        local payload; payload=$(stats_compute json)
        echo "Projects, last 30 days"
        printf '%s' "$payload" | jq -r '.projects[] | "  \(.project)\t\(.worked)\t\(.prompts)"' \
            | while IFS=$'\t' read -r project worked prompts; do
                printf '  %-24s %8s   %s prompts\n' "$project" "$(human_dur "$worked")" "$prompts"
            done
        local longest; longest=$(printf '%s' "$payload" | jq -r '.longest.secs // empty')
        local longest_at; longest_at=$(printf '%s' "$payload" | jq -r '.longest.epoch // empty')
        if [ -n "$longest" ]; then
            echo
            printf '  longest single stretch   %s  (%s)\n' "$(human_dur "$longest")" "$(date -r "$longest_at" '+%Y-%m-%d %H:%M')"
        fi
    fi
    echo
    printf '  %s events since %s\n' "${STAT_EVENTS:-0}" "$(date -r "$(head -1 "$EVENTS_FILE" | cut -f1)" '+%Y-%m-%d' 2>/dev/null || echo '?')"
    printf '  history  %s\n' "$EVENTS_FILE"
}

cmd_logs() {
    if [ -f "$LOG_FILE" ]; then
        tail -30 "$LOG_FILE"
    else
        echo "(no log file yet at $LOG_FILE, submit a prompt to generate one)"
    fi
}

cmd_enable_lid_closed() {
    if [ "$(id -u)" -ne 0 ]; then
        echo "This installs a sudoers rule. Re-running with sudo..."
        exec sudo "$0" enable-lid-closed
    fi
    local user="${SUDO_USER:-$USER}"
    if [ -z "$user" ] || [ "$user" = "root" ]; then
        echo "error: could not determine the non-root user to grant the rule to." >&2
        exit 1
    fi
    local tmp; tmp=$(mktemp)
    printf '%s ALL=(ALL) NOPASSWD: /usr/bin/pmset -b disablesleep *\n' "$user" > "$tmp"
    if ! visudo -cf "$tmp" >/dev/null; then
        echo "error: generated sudoers entry failed validation" >&2
        rm -f "$tmp"
        exit 1
    fi
    install -m 0440 -o root -g wheel "$tmp" "$SUDOERS_FILE"
    rm -f "$tmp"
    echo "lid-closed support enabled (rule at $SUDOERS_FILE, user $user)"
    echo "the next Claude prompt will start blocking clamshell sleep on battery"
}

cmd_disable_lid_closed() {
    if [ "$(id -u)" -ne 0 ]; then
        exec sudo "$0" disable-lid-closed
    fi
    if [ -f "$SUDOERS_FILE" ]; then
        rm -f "$SUDOERS_FILE"
        echo "removed $SUDOERS_FILE"
    else
        echo "$SUDOERS_FILE not present, nothing to do"
    fi
    pmset -b disablesleep 0 >/dev/null 2>&1 || true
}

case "${1:-help}" in
    status)
        shift
        case "${1:-}" in
            --json)  cmd_status_json ;;
            *)       cmd_status "${1:-}" ;;
        esac
        ;;
    logs)                cmd_logs ;;
    stats)               shift; cmd_stats "${1:-}" ;;
    menubar)             shift; cmd_menubar "${1:-status}" ;;
    enable-lid-closed)   cmd_enable_lid_closed ;;
    disable-lid-closed)  cmd_disable_lid_closed ;;
    help|-h|--help)      usage ;;
    -V|--version)        echo "$VERSION" ;;
    *)                   echo "unknown command: $1" >&2; usage >&2; exit 2 ;;
esac
