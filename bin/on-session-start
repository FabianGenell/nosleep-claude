#!/bin/bash
HOOK=SessionStart
. "$(dirname "$0")/common.sh"

SESSION_ID=$(read_session_id)
[ -z "$SESSION_ID" ] && exit 0

# Wipe state for any session whose caffeinate is gone (handles prior crashes).
clean_stale_sessions

# If, after cleanup, NO sessions hold the lid lock, reset pmset to a safe
# baseline. If other sessions are still active, leave their state alone.
if [ "$(count_active_lids)" = "0" ]; then
    _pmset_enable || true
fi

# Drop any leftover state for this specific session_id (unlikely collision).
rm -f "$NOSLEEP_DIR/$SESSION_ID.cpid" "$NOSLEEP_DIR/$SESSION_ID.lid"

log "session=$SESSION_ID started (active lid holders: $(count_active_lids))"
exit 0
