#!/bin/bash
HOOK=SessionEnd
. "$(dirname "$0")/common.sh"

SESSION_ID=$(read_session_id)
[ -z "$SESSION_ID" ] && exit 0

CPID_FILE="$NOSLEEP_DIR/$SESSION_ID.cpid"

if [ -f "$CPID_FILE" ]; then
    kill_pid_silent "$(cat "$CPID_FILE" 2>/dev/null)"
    rm -f "$CPID_FILE"
fi

# Refcounted release in case the lid lock was held by this session.
lid_lock_release

log "session=$SESSION_ID ended"
exit 0
