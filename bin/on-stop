#!/bin/bash
HOOK=Stop
. "$(dirname "$0")/common.sh"

read_hook_input
SESSION_ID=$(hook_field session_id)
[ -z "$SESSION_ID" ] && exit 0

# Claude just finished responding. Restart the timer so the grace window
# counts from now, then let it expire on its own.
refresh_caffeinate force

lid_lock_release

record_event stop

exit 0
